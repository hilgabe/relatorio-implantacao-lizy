# Configuração do app web Firebase (valores públicos, não são segredos).
# Obtenha com: firebase apps:sdkconfig WEB <APP_ID> --project relatorio-implantacao-lizy
VITE_FIREBASE_API_KEY=sua-api-key
VITE_FIREBASE_AUTH_DOMAIN=relatorio-implantacao-lizy.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=relatorio-implantacao-lizy
VITE_FIREBASE_APP_ID=seu-app-id
